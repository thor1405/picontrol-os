# ==============================================================================
# PiControl OS — Environment Variables
# ==============================================================================

# Public Web Dashboard Port (Choose a non-conflicting port, e.g. 8090)
PICONTROL_PORT=8090

# Node Environment (production / development / test)
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random string: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-random-secret-key-for-rpi5

# Initial Default Administrator Account Credentials
# (Can be changed anytime inside Settings -> Administrator Password)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=picontrol2026

# Privileged Docker Controls
# Set to 'true' to allow Start, Stop, and Restart actions on Docker containers.
# Disabled by default for maximum security.
ENABLE_DOCKER_CONTROLS=false

# SSRF Guard for Website Uptime Checks
# Set to 'true' if you want to allow monitoring internal LAN/loopback addresses (192.168.x.x, 127.0.0.1)
ALLOW_PRIVATE_IP_CHECKS=false

# Prometheus Historical Metrics Data Retention
PROMETHEUS_RETENTION=15d

# Internal Prometheus Connection URL
PROMETHEUS_URL=http://prometheus:9090

# Host Docker Engine Socket
DOCKER_SOCKET=/var/run/docker.sock
